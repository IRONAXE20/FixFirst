# ---- The brain's model ----
# Claude runs the brain when ANTHROPIC_API_KEY is set (LLM_PROVIDER=auto). Set LLM_PROVIDER=sarvam
# to use sarvam-105b instead. With neither key, Type mode runs an offline keyword demo brain.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Sarvam (https://dashboard.sarvam.ai) ----
# Browser voice calls (speech-to-text and text-to-speech) need a Sarvam key (sk_...).
# Phone calls through Bolna don't: Bolna runs Sarvam's voices on its side.
SARVAM_API_KEY=
# LLM built for real-time voice agents (32K context, tool calling, no reasoning delay)
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v4
# codemix keeps English words in Roman script ("AC ठंडा नहीं, IE code", "smoke") so error codes
# and the safety screen work; transcribe writes them in Devanagari ("एसी", "आईई", "स्मोक").
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3
# Seconds before an LLM call is treated as failed (the caller hears a fallback)
LLM_TIMEOUT_SECONDS=8

# ---- Database ----
# Local: SQLite file. Production: Supabase Postgres (Session pooler connection string, as copied from
# Supabase; postgresql:// is fine). FixFirst creates its tables in its own `fixfirst` schema, not `public`,
# so they aren't exposed through Supabase's REST API. e.g.
# DATABASE_URL=postgresql+psycopg://postgres.xxxx:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///data/fixfirst.db

# ---- WhatsApp Cloud API (Meta) ----
# dry_run logs every message to the outbox (visible on /ops) instead of sending it.
WHATSAPP_MODE=dry_run
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Business-initiated messages need approved templates; each takes one body variable {{1}}.
WHATSAPP_TEMPLATE_CUSTOMER=fixfirst_customer_update
WHATSAPP_TEMPLATE_TEAM=fixfirst_team_ticket
WHATSAPP_TEMPLATE_LANG=en

# ---- Server ----
# Used to build photo-upload links sent on WhatsApp (use your ngrok/https URL when testing on a phone)
PUBLIC_BASE_URL=http://localhost:7860
PORT=7860

# ---- Optional ----
# Let the agent answer informational questions from the document library (off by default:
# the council asked that every spoken instruction come from a reviewed playbook step).
ENABLE_DOC_QA=false

# ---- Customers ----
# rentbasket: look callers up by mobile number in RentBasket's customer API (copied into the local
# database for tickets and /ops). demo: only the three made-up demo customers.
CUSTOMER_SOURCE=rentbasket
RENTBASKET_API_URL=https://acapi.rentbasket.com/api/get-customer-details

# ---- Phone calls through Bolna (https://platform.bolna.ai) ----
# Bolna runs the call (telephony, Sarvam speech) and calls FixFirst as its custom LLM.
# `python -m fixfirst bolna-setup --public-url https://...` fills in BOLNA_AGENT_ID and FIXFIRST_LLM_KEY.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
FIXFIRST_LLM_KEY=

# ---- Admin and retention ----
# Needed to save playbook edits on /knowledge (editing is off without it). Use a long random value.
ADMIN_KEY=
# Customer photos are deleted this many days after their ticket is closed.
PHOTO_RETENTION_DAYS=7
